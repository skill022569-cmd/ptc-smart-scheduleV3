{
  "name": "ptc-smart-schedule",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push --skip-generate && node prisma/seed.js && next build",
    "build:app": "next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "test": "node --test test/*.test.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "jose": "5.9.6",
    "next": "14.2.35",
    "prisma": "5.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": { "node": ">=18.18" }
}
